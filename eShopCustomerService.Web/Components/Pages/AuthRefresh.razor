@page "/auth-refresh"
@attribute [Authorize(Policy = DemoAuthentication.PermissionControlsPolicy)]

<PageTitle>Authentication refresh | eShop</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">PRESENTER CONTROLS</span><h1>Keep permissions current.</h1>
        <p>Change Taylor's refund permission while keeping the return editor visible.</p></div>
</div>
<section class="panel auth-controls">
    <div class="panel-heading"><h2>Taylor Brooks</h2><span class="badge @(refundApproval ? "success" : "warning")">Refund approval: @(refundApproval ? "allowed" : "removed")</span></div>
    <div class="api-actions">
        <form method="post" action="/demo/auth-refresh/permission">
            <input type="hidden" name="refundApproval" value="false" />
            <button class="button secondary" type="submit">Remove refund approval</button>
        </form>
        <form method="post" action="/demo/auth-refresh/permission">
            <input type="hidden" name="refundApproval" value="true" />
            <button class="button" type="submit">Restore refund approval</button>
        </form>
    </div>
    <div class="notice subtle"><Icon Name="shield" /><span>These HTTP controls issue an updated cookie. Without reloading, the editor applies it at its next authentication refresh, normally within about 10 seconds.</span></div>
    <p class="fine-print">Demo timing, not a production revocation policy. Restore refund approval before continuing.</p>
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    private bool refundApproval;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthenticationState).User;
        refundApproval = user.IsInRole("RefundApprover");
    }
}
