@page "/contracts"
@attribute [Authorize(Policy = "CustomerService")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<Contracts> Logger

<PageTitle>API workspace | eShop</PageTitle>
<div class="page-heading"><div><span class="eyebrow">CONTRACTS &amp; VALIDATION</span><h1>The same rules. Every caller.</h1><p>Real requests from this browser to the application's authenticated Minimal APIs.</p></div><a class="button secondary" href="/returns/48021">Back to featured return</a></div>
<div class="api-grid">
    <section class="panel">
        <div class="panel-heading"><div><h2>Explore the resolution contract</h2><p>Two business outcomes, expressed as ordinary JSON.</p></div></div>
        <div class="api-actions">
            <button class="button secondary" @onclick='() => SendAsync("/api/examples/refund")' disabled="@InteractionUnavailable">Refund JSON</button>
            <button class="button secondary" @onclick='() => SendAsync("/api/examples/replacement")' disabled="@InteractionUnavailable">Replacement JSON</button>
            <button class="button secondary" @onclick='() => SendAsync("/openapi/v1.json")' disabled="@InteractionUnavailable">OpenAPI union schemas</button>
        </div>
        <p class="fine-print">The schema view extracts the version and resolution schemas from the live OpenAPI document. <a href="/openapi/v1.json" target="_blank" rel="noopener">Open full document</a>.</p>
        <div class="panel-divider"></div>
        <h2>Validate a replacement request</h2>
        <p>Submit an unavailable model directly, then try the compatible alternative. The endpoint runs the model's async inventory rule before its handler.</p>
        <label for="request-json" class="small-label">JSON request body</label>
        <textarea id="request-json" class="json-editor" rows="8" @bind="requestBody" spellcheck="false" disabled="@InteractionUnavailable"></textarea>
        <div class="api-actions">
            <button class="button" @onclick="ValidateAsync" disabled="@InteractionUnavailable">@(busy ? "Sending request..." : "Send validation request") <Icon Name="arrow" /></button>
            <button class="text-button" @onclick="UseAvailable" disabled="@InteractionUnavailable">Use available model</button>
            <button class="text-button" @onclick="UseUnavailable" disabled="@InteractionUnavailable">Use unavailable model</button>
        </div>
    </section>
    <section class="panel response-panel">
        <div class="panel-heading"><div><h2>Response</h2><p class="request-path">@lastRequest</p></div>
            @if (result is not null)
            {
                <span class="badge @(result.Status < 400 ? "success" : "warning")">HTTP @result.Status</span>
            }
        </div>
        @if (busy)
        {
            <div class="response-empty" role="status"><span class="spinner"></span><p>Awaiting the actual HTTP response...</p></div>
        }
        else if (failure is not null)
        {
            <p class="notice error" role="alert">@failure</p>
        }
        else if (result is not null)
        {
            <pre class="json-response" data-testid="api-response">@result.Body</pre>
        }
        else
        {
            <div class="response-empty"><Icon Name="code" /><h3>A contract you can inspect.</h3><p>Choose an example or send a request to see the response here.</p></div>
        }
    </section>
</div>

@code {
    private ApiWorkspaceInterop? interop;
    private ApiWorkspaceResponse? result;
    private bool busy;
    private string? failure;
    private string lastRequest = "No request sent";
    private string requestBody = Body("DOCK-PRO");
    private bool InteractionUnavailable => busy || !RendererInfo.IsInteractive;

    private static string Body(string code) => JsonSerializer.Serialize(new
    {
        orderId = 48021,
        productCode = code,
        deliveryAddress = "120 Market Street, Seattle, WA 98101"
    }, new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true });

    private void UseAvailable() => requestBody = Body("DOCK-PRO-PLUS");
    private void UseUnavailable() => requestBody = Body("DOCK-PRO");
    private Task ValidateAsync() => SendAsync("/api/replacements/validate", "POST", requestBody);

    private async Task SendAsync(string path, string method = "GET", string? body = null)
    {
        busy = true;
        failure = null;
        lastRequest = $"{method} {path}";
        try
        {
            interop ??= new(JS);
            result = await interop.SendAsync(path, method, body);
        }
        catch (ApiRequestException exception)
        {
            Logger.LogWarning(exception, "API workspace browser request failed");
            failure = "The browser request failed. Check connectivity and your sign-in, then retry.";
        }
        finally
        {
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (interop is not null)
        {
            await interop.DisposeAsync();
        }
    }
}
