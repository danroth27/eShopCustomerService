<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>
<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <p class="components-reconnect-first-attempt-visible">Rejoining your workspace...</p>
        <p class="components-reconnect-repeated-attempt-visible">Trying again in <span id="components-seconds-to-next-attempt"></span> seconds.</p>
        <p class="components-reconnect-failed-visible">The connection could not be restored. Check your network and retry.</p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">Retry</button>
        <p class="components-pause-visible">Your workspace is paused. Resume to continue your unsaved resolution.</p>
        <p class="components-resume-failed-visible">The workspace could not resume. Retry without refreshing to avoid discarding recovery state.</p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">Resume</button>
    </div>
</dialog>
