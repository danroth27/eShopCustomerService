@page "/agentic/{OrderId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "CustomerService")]
@implements IAsyncDisposable
@using System.Text.Json
@using AGUI.Abstractions
@using Microsoft.AspNetCore.Components.AI
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.AI
@using eShopCustomerService.Contracts
@using eShopCustomerService.Web.Agentic
@inject AgentConnection Connection
@inject WorkspaceService Store
@inject IJSRuntime JS

<PageTitle>Agent workspace | eShop</PageTitle>

@if (!Connection.IsConfigured)
{
    <div class="page-heading"><div><span class="eyebrow">AGENT WORKSPACE</span><h1>Connect your service agent</h1>
        <p>The workspace needs a connection to the customer-service agent.</p></div></div>
    <section class="panel">
        <h2>One-time local setup</h2>
        <p>Start the AppHost to connect this app to the agent service through <code>Agentic:ServiceUrl</code>. Configure Foundry in the AppHost's user secrets, not in the web frontend.</p>
        <a class="button secondary" href="/returns">Continue with returns &amp; exchanges</a>
    </section>
}
else if (_order is null || _agent is null)
{
    <section class="panel"><h1>@(_loaded ? "Order not found" : "Opening your workspace...")</h1></section>
}
else
{
    var state = _agent.State.Value;
    <div class="page-heading agent-heading">
        <div><span class="eyebrow">CUSTOMER SERVICE / CASE @OrderId</span>
            <h1>A delayed delivery. A clear next step.</h1>
            <p>Investigate together, shape the resolution, and approve the action.</p></div>
        <span class="badge @(state.Status == "Resolved" ? "success" : "warning")">@state.Status</span>
    </div>
    <div class="agent-workspace">
        <section class="agent-case">
            <div class="panel">
                <div class="panel-heading"><div><span class="eyebrow">THE CUSTOMER</span><h2>@_order.Customer</h2></div>
                    <span class="avatar large">TC</span></div>
                <p>@_order.Company <span class="separator">/</span> Order @OrderId</p>
                <div class="agent-product"><Icon Name="bag" /><div><strong>@_order.Product</strong><small>@_order.PaidAmount.ToString("C") paid</small></div></div>
                <div class="agent-customer-message"><span class="eyebrow">CUSTOMER REQUEST</span><p>@_order.Reason</p></div>
                <div class="agent-evidence"><span class="status-dot"></span><span>Seeded carrier history. Live local stock.</span></div>
            </div>
            <div class="panel agent-resolution">
                <div class="panel-heading"><div><span class="eyebrow">SHARED WORKSPACE</span><h2>Replacement plan</h2></div>
                    <span class="badge">@state.Status</span></div>
                <label for="agent-address">Delivery address</label>
                <input id="agent-address" value="@state.DeliveryAddress" @onchange="ChangeAddress"
                    disabled="@(_status is ConversationStatus.Streaming or ConversationStatus.AwaitingInput || state.Status == "Resolved")" />
                <p class="agent-hint">Your edits become context for the next agent request.</p>
                <div class="agent-plan-line"><span>Replacement</span><strong>@state.ProductCode</strong></div>
                <div class="agent-plan-line"><span>Inventory commitment</span><strong>@(state.Status == "Resolved" ? "1 unit allocated locally" : "None yet")</strong></div>
                <div class="agent-reply @(_agent.State.HasPendingPredictiveState ? "agent-reply-preview" : "")">
                    <span class="eyebrow">@(_agent.State.HasPendingPredictiveState ? "REPLY EDIT PREVIEW / NOT SENT" : "PROPOSED CUSTOMER REPLY / NOT SENT")</span>
                    <p>@(string.IsNullOrWhiteSpace(state.CustomerReply) ? "Ask the agent to prepare a replacement and draft a reply." : state.CustomerReply)</p>
                    @if (_agent.State.HasPendingPredictiveState)
                    {
                        <p class="agent-hint">Preview only. Accept the reply edits or discard them to restore the previous text.</p>
                    }
                </div>
                @if (state.DraftId is { } draftId)
                {
                    <a class="text-button" href="@($"/review/{draftId}")" target="_blank" rel="noopener">Open the saved draft in the existing review workflow &nearr;</a>
                }
                @if (state.Status == "Resolved")
                {
                    <div class="agent-success"><Icon Name="check" /> Resolution recorded. No real shipment was created.</div>
                    <a class="text-button" href="@($"/returns/{OrderId}")">View the order and authoritative audit history</a>
                }
            </div>
        </section>
        <section class="panel agent-chat-panel" @ref="_chatPanel">
            <div class="panel-heading"><div><span class="eyebrow">SERVICE AGENT</span><h2>Work the case together</h2></div>
                <span class="badge">@(_status switch { ConversationStatus.AwaitingInput => "Your input", ConversationStatus.Streaming => "Working", ConversationStatus.Error => "Needs attention", _ => "Ready" })</span></div>
            <p class="agent-chat-intro">Start with: Investigate this delayed delivery and recommend a resolution.</p>
            <ChatPage Agent="_agent" Placeholder="Ask the agent to investigate, prepare, or confirm...">
                <MessageListContent>
                    <AgentControls StatusChanged="ChangeStatus" />
                    <BlockRenderer TBlock="CaseContextBlock" Context="block">
                        <div class="agent-tool-card">
                            <div class="agent-tool-title"><Icon Name="return" /><strong>@(block.HasResult ? "Case evidence retrieved" : "Checking order, carrier history, and stock...")</strong></div>
                            @if (block.CaseInfo is { } evidence)
                            {
                                <div class="agent-tool-facts">
                                    <div><span>Order</span><strong>@evidence.Order.OrderId</strong></div>
                                    <div><span>Original model</span><strong>@(evidence.Inventory.First(i => i.ProductCode == "DOCK-PRO").Available) available</strong></div>
                                    <div><span>Compatible upgrade</span><strong>@(evidence.Inventory.First(i => i.ProductCode == "DOCK-PRO-PLUS").Available) available</strong></div>
                                </div>
                                @foreach (var entry in evidence.Activity.Take(3))
                                {
                                    <div class="agent-evidence-line" @key="entry.Id">@entry.Action</div>
                                }
                            }
                        </div>
                    </BlockRenderer>
                    <BlockRenderer TBlock="UIActionBlock" Context="action" When="@(block => block.ToolName == "propose_customer_reply")">
                        <div class="agent-tool-card">
                            <div class="agent-tool-title"><Icon Name="grid" /><strong>Review reply edits</strong></div>
                            @if (action.IsComplete)
                            {
                                <p>@action.Result?.Result</p>
                            }
                            else if (_agent.State.HasPendingPredictiveState)
                            {
                                <p>The reply preview is in the shared workspace. Accepting edits does not send the reply or approve the replacement.</p>
                                <div class="agent-approval-actions">
                                    <button class="button secondary" disabled="@_reviewingReply" @onclick="() => ReviewReplyAsync(action, false)">Discard reply edits</button>
                                    <button class="button" disabled="@_reviewingReply" @onclick="() => ReviewReplyAsync(action, true)">Accept reply edits</button>
                                </div>
                            }
                            else
                            {
                                <p>This reply preview is no longer pending.</p>
                            }
                        </div>
                    </BlockRenderer>
                    <BlockRenderer TBlock="UIActionBlock" Context="action" When="@(block => block.ToolName == "show_resolution_review")">
                        <div class="agent-tool-card">
                            <div class="agent-tool-title"><Icon Name="grid" /><strong>Frontend tool: resolution review</strong></div>
                            @if (action.IsComplete)
                            {
                                <p>Review opened in the Blazor UI. No allocation authorized.</p>
                            }
                            else
                            {
                                <p>The agent requested a read-only review of the current draft.</p>
                                <button class="button secondary" @onclick="() => action.InvokeAsync()">Open resolution review</button>
                            }
                        </div>
                    </BlockRenderer>
                    <BlockRenderer TBlock="FunctionApprovalBlock" Context="block">
                        <div class="agent-approval">
                            <span class="eyebrow">YOUR DECISION</span><h3>Confirm this replacement?</h3>
                            <p>Approval allows the server to allocate one unit and record the resolution in this local demo.</p>
                            <dl>
                                @if (block.Arguments is { } arguments)
                                {
                                    @foreach (var argument in arguments.Where(a => a.Key != "draftId"))
                                    {
                                        <dt>@(argument.Key == "productCode" ? "Replacement" : argument.Key == "deliveryAddress" ? "Deliver to" : argument.Key)</dt>
                                        <dd>@argument.Value</dd>
                                    }
                                }
                            </dl>
                            @if (block.Status == ApprovalStatus.Pending)
                            {
                                <div class="agent-approval-actions">
                                    <button class="button" @onclick="block.Approve">Approve replacement</button>
                                    <button class="button secondary" @onclick="() => block.Reject()">Reject</button>
                                </div>
                            }
                            else
                            {
                                <strong>@(block.Status == ApprovalStatus.Approved ? "Approved" : "Rejected. No allocation authorized.")</strong>
                            }
                        </div>
                    </BlockRenderer>
                </MessageListContent>
            </ChatPage>
        </section>
    </div>
    @if (_reviewState is { } review)
    {
        <div class="agent-review-backdrop">
            <section class="panel agent-review">
                <div class="panel-heading">
                    <div><span class="eyebrow">OPENED BY A FRONTEND TOOL</span><h2>Resolution review</h2></div>
                    <button class="button secondary" @onclick="CloseReview">Close review</button>
                </div>
                <ResolutionSummary Resolution="@(new Resolution(new ReplacementResolution(review.ProductCode, review.DeliveryAddress)))" />
                <div class="agent-reply"><span class="eyebrow">PROPOSED CUSTOMER REPLY / NOT SENT</span><p>@review.CustomerReply</p></div>
                <p class="agent-hint">Reviewing is not approval. Inventory remains uncommitted.</p>
            </section>
        </div>
    }
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private ReturnCase? _order;
    private UIAgent<CaseWorkspaceState>? _agent;
    private IChatClient? _chatClient;
    private IDisposable? _stateSubscription;
    private bool _loaded;
    private ConversationStatus _status;
    private ElementReference _chatPanel;
    private AgentWorkspaceScroll? _scroll;
    private CaseWorkspaceState? _reviewState;
    private bool _reviewingReply;
    [Parameter] public int OrderId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> Authentication { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (!Connection.IsConfigured)
        {
            return;
        }
        _order = await Store.GetCaseAsync(OrderId);
        _loaded = true;
        if (_order is null)
        {
            return;
        }
        _chatClient = Connection.Create(OrderId, (await Authentication).User);
        var threadId = Guid.NewGuid().ToString("N");
        var replacement = _order.Resolution?.Value is ReplacementResolution resolved ? resolved : null;
        _agent = new UIAgent<CaseWorkspaceState>(_chatClient, options =>
        {
            options.RegisterUIAction(AIFunctionFactory.Create(
                (string customerReply, bool? accepted = null) =>
                    CaseWorkspaceUpdates.ReviewReply(_agent!.State, customerReply, accepted),
                name: "propose_customer_reply",
                description: "Preview a complete revised customer reply for the user to accept or discard. Does not change the replacement draft, send a message, or allocate stock. Leave accepted unset; the user decides."));
            options.RegisterUIAction(AIFunctionFactory.Create(
                ShowResolutionReview,
                name: "show_resolution_review",
                description: "Open a read-only resolution review in the Blazor UI for the current saved draft. Does not approve, allocate inventory, or send a message."));
            options.AddGeneratedToolBlocks();
            options.ChatOptions = new ChatOptions
            {
                RawRepresentationFactory = _ => new RunAgentInput
                {
                    ThreadId = threadId,
                    State = JsonSerializer.SerializeToElement(_agent!.State.Value, JsonOptions)
                }
            };
            options.StateMapper = context => CaseWorkspaceUpdates.Map(context, _agent!.State);
        }, new()
        {
            OrderId = OrderId,
            ProductCode = replacement?.ProductCode ?? "DOCK-PRO-PLUS",
            DeliveryAddress = replacement?.DeliveryAddress ?? _order.DeliveryAddress,
            Status = _order.Status == "Resolved" ? "Resolved" : "Investigating"
        });
        _stateSubscription = _agent.State.OnChanged(RefreshWorkspace);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_agent is not null && _scroll is null)
        {
            _scroll = new(JS);
            await _scroll.InitializeAsync(_chatPanel);
        }
    }

    private void ChangeAddress(ChangeEventArgs args)
    {
        if (_agent is not null && _status is not (ConversationStatus.Streaming or ConversationStatus.AwaitingInput)
            && _agent.State.Value.Status != "Resolved")
        {
            _agent.State.Value = _agent.State.Value with { DeliveryAddress = args.Value?.ToString() ?? "" };
        }
    }

    private void ChangeStatus(ConversationStatus status) => _status = status;

    private async Task ReviewReplyAsync(UIActionBlock action, bool accepted)
    {
        if (_reviewingReply || action.IsComplete)
        {
            return;
        }
        _reviewingReply = true;
        try
        {
            action.Call.Arguments ??= new Dictionary<string, object?>();
            action.Call.Arguments["accepted"] = accepted;
            await action.InvokeAsync();
        }
        finally
        {
            _reviewingReply = false;
        }
    }

    private string ShowResolutionReview()
    {
        var state = _agent?.State.Value;
        if (state is not { Status: "Draft", DraftId: not null })
        {
            throw new InvalidOperationException("Prepare a replacement draft before opening its resolution review.");
        }
        _reviewState = state;
        StateHasChanged();
        return "The resolution review is open in the Blazor UI. No approval was given, no stock was allocated, and the reply was not sent.";
    }

    private void CloseReview() => _reviewState = null;

    private async void RefreshWorkspace()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception error)
        {
            await DispatchExceptionAsync(error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _stateSubscription?.Dispose();
        _agent?.Dispose();
        (_chatClient as IDisposable)?.Dispose();
        if (_scroll is not null)
        {
            await _scroll.DisposeAsync();
        }
    }
}
